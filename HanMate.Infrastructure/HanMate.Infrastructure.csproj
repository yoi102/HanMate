<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <EmbeddedResource Include="Dictionary\xinhua.sqlite.gz" LogicalName="Dictionary.xinhua.sqlite.gz" />
    <EmbeddedResource Include="Dictionary\XINHUA-NOTICE.json" LogicalName="Dictionary.XINHUA-NOTICE.json" />
    <EmbeddedResource Include="Dictionary\XINHUA-README.txt" LogicalName="Dictionary.XINHUA-README.txt" />
    <EmbeddedResource Include="Dictionary\XINHUA-LICENSE.txt" LogicalName="Dictionary.XINHUA-LICENSE.txt" />
    <EmbeddedResource Include="Dictionary\PYPINYIN-LICENSE.txt" LogicalName="Dictionary.PYPINYIN-LICENSE.txt" />
    <EmbeddedResource Include="Dictionary\JIEBA-LICENSE.txt" LogicalName="Dictionary.JIEBA-LICENSE.txt" />
    <EmbeddedResource Include="Dictionary\OPENCC-LICENSE.txt" LogicalName="Dictionary.OPENCC-LICENSE.txt" />
    <EmbeddedResource Include="Dictionary\learning-examples.tsv" LogicalName="Dictionary.learning-examples.tsv" />
    <EmbeddedResource Include="Voices\catalog.json" LogicalName="Voices.catalog.json" />
    <EmbeddedResource Include="Voices\catalog-kokoro.json" LogicalName="Voices.catalog-kokoro.json" />
