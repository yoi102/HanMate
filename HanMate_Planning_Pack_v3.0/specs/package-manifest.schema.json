{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package-manifest.schema.json",
  "title": "HanMate package-manifest.schema.json — draft contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packageType": {
      "enum": [
        "content",
        "backup",
        "resource"
      ]
    },
    "packageId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producerAppVersion": {
      "type": "string"
    },
    "contentCatalogVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "contents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "folders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "favorites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioAssets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioBindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contents",
        "folders",
        "favorites",
        "audioAssets",
        "audioBindings",
        "resources"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(contents\\.json|settings\\.json|collections\\.json|resources\\.json|resource\\.json|audio/index\\.json|audio/[0-9a-f]{64}\\.(wav|mp3|m4a))$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "byteLength",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 9999
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "packageType",
    "packageId",
    "createdAtUtc",
    "producerAppVersion",
    "contentCatalogVersion",
    "counts",
    "files",
    "warnings"
  ],
  "additionalProperties": false
}
