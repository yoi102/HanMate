{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-state.schema.json",
  "title": "HanMate resource-state.schema.json — design contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descriptor": {
            "$ref": "resource-descriptor.schema.json"
          },
          "descriptorSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payloadStatus": {
            "enum": [
              "included",
              "referenceOnly"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "missingReason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "removedEntryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "payloadFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "descriptor",
          "descriptorSha256",
          "payloadStatus",
          "enabled",
          "priority",
          "missingReason",
          "removedEntryIds",
          "payloadFingerprint"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "retainedContentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "teachingItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "groupCode": {
            "enum": [
              "initial",
              "spellingAid",
              "simpleFinal",
              "compoundFinal",
              "nasalFinal",
              "wholeSyllable"
            ]
          },
          "display": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "demoAudioAssetId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tone": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "status": {
                  "enum": [
                    "available",
                    "unavailable"
                  ]
                },
                "contentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "highlight": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "contentId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "unitId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "tokenId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "pinyinElementStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "pinyinElementLength": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "contentId",
                        "unitId",
                        "tokenId",
                        "pinyinElementStart",
                        "pinyinElementLength"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "tone",
                "status",
                "contentId",
                "highlight",
                "note"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 4
          },
          "reviewStatus": {
            "enum": [
              "draft",
              "needsReview",
              "approved"
            ]
          }
        },
        "required": [
          "id",
          "groupCode",
          "display",
          "sortOrder",
          "demoAudioAssetId",
          "examples",
          "reviewStatus"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    }
  },
  "required": [
    "schemaVersion",
    "resources",
    "retainedContentIds"
  ],
  "additionalProperties": false
}
