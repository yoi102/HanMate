{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.schema.json",
  "title": "HanMate settings.schema.json — draft contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "uiLanguage": {
      "enum": [
        "zh-Hans",
        "ja",
        "en"
      ]
    },
    "reading": {
      "type": "object",
      "properties": {
        "scalePercent": {
          "type": "integer",
          "minimum": 100,
          "maximum": 200
        },
        "showPinyin": {
          "type": "boolean"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 18,
          "maximum": 40
        }
      },
      "required": [
        "showPinyin",
        "fontSize"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "localWithSystemFallback",
            "localOnly"
          ]
        },
        "preferredLocale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        }
      },
      "required": [
        "policy",
        "preferredLocale"
      ],
      "additionalProperties": false
    },
    "wordCategories": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^custom-[0-9a-f]{32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "wordCategoryOverrides": {
      "type": "array",
      "maxItems": 18,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "enum": ["common", "address", "greetings", "numbers", "quantifiers", "length", "weight", "time", "family", "food", "seasonings", "kitchenware", "household", "colors", "travel", "study", "nature", "other"] },
          "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 40 },
          "hidden": { "type": "boolean" }
        },
        "required": ["id", "name", "hidden"],
        "additionalProperties": false
      }
    },
    "favorites": {
      "type": "object",
      "properties": {
        "lastFolderId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lastFolderId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "uiLanguage",
    "reading",
    "audio",
    "favorites"
  ],
  "additionalProperties": false
}
