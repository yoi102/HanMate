<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HanMate.App.Controls"
             x:Class="HanMate.App.Pages.LearningPage"
             Style="{StaticResource LibraryPage}"
             Title="{Binding NavLearn}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" MaximumWidthRequest="920">
            <Grid x:Name="CategoryGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" SizeChanged="OnCategoriesSizeChanged">
                <controls:NavigationTile Grid.Row="0" Grid.Column="0" Title="{Binding KindWord}" Detail="{Binding LearnWordHint}" CommandParameter="Word" Clicked="OnKindClicked" ActionId="Learning.Word" />
                <controls:NavigationTile Grid.Row="0" Grid.Column="1" Title="{Binding KindText}" Detail="{Binding LearnTextHint}" CommandParameter="Text" Clicked="OnKindClicked" ActionId="Learning.Text" />
                <controls:NavigationTile Grid.Row="1" Grid.Column="0" Title="{Binding KindGrammar}" Detail="{Binding LearnGrammarHint}" CommandParameter="Grammar" Clicked="OnKindClicked" ActionId="Learning.Grammar" />
                <controls:NavigationTile Grid.Row="1" Grid.Column="1" Title="{Binding KindPoem}" Detail="{Binding LearnPoemHint}" CommandParameter="Poem" Clicked="OnKindClicked" ActionId="Learning.Poem" />
            </Grid>
            <controls:NavigationTile Compact="True" Title="{Binding LearnDraftsTitle}" Detail="{Binding LearnDraftsHint}" Clicked="OnDraftsClicked" ActionId="Learning.Drafts" />
            <Label x:Name="CatalogStatus" Style="{StaticResource LibraryMuted}" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
