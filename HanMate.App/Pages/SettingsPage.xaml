<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HanMate.App.Controls"
             x:Class="HanMate.App.Pages.SettingsPage"
             Style="{StaticResource LibraryPage}"
             Title="{Binding NavSettings}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="760">
            <Label Text="{Binding SettingsLanguageGroup}" Style="{StaticResource LibrarySection}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="ChineseLanguageButton" Grid.Column="0" AutomationId="Settings.Language.Chinese"
                        Style="{StaticResource LibrarySecondaryButton}" Text="简体中文" Clicked="OnChineseClicked" />
                <Button x:Name="JapaneseLanguageButton" Grid.Column="1" AutomationId="Settings.Language.Japanese"
                        Style="{StaticResource LibrarySecondaryButton}" Text="日本語" Clicked="OnJapaneseClicked" />
                <Button x:Name="EnglishLanguageButton" Grid.Column="2" AutomationId="Settings.Language.English"
                        Style="{StaticResource LibrarySecondaryButton}" Text="English" Clicked="OnEnglishClicked" />
            </Grid>
            <Label Text="{Binding SettingsThemeGroup}" Style="{StaticResource LibrarySection}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="SystemThemeButton" Grid.Column="0" AutomationId="Settings.Theme.System"
                        Text="{Binding ThemeSystem}" Style="{StaticResource LibrarySecondaryButton}" Clicked="OnSystemThemeClicked" />
                <Button x:Name="LightThemeButton" Grid.Column="1" AutomationId="Settings.Theme.Light"
                        Text="{Binding ThemeLight}" Style="{StaticResource LibrarySecondaryButton}" Clicked="OnLightThemeClicked" />
                <Button x:Name="DarkThemeButton" Grid.Column="2" AutomationId="Settings.Theme.Dark"
                        Text="{Binding ThemeDark}" Style="{StaticResource LibrarySecondaryButton}" Clicked="OnDarkThemeClicked" />
            </Grid>
            <Label Text="{Binding SettingsContentGroup}" Style="{StaticResource LibrarySection}" />
            <controls:NavigationTile Compact="True" Title="{Binding ManageResources}" Clicked="OnResourcesClicked" ActionId="Settings.Resources" />
            <controls:NavigationTile Compact="True" Title="{Binding ManageDictionaries}" Clicked="OnDictionariesClicked" ActionId="Settings.Dictionaries" />
            <Label Text="{Binding SettingsAudioGroup}" Style="{StaticResource LibrarySection}" />
            <controls:NavigationTile Compact="True" Title="{Binding SpeechSettings}" Clicked="OnSpeechClicked" ActionId="Settings.Speech" />
            <controls:NavigationTile Compact="True" Title="{Binding PinyinResources}" Clicked="OnPinyinResourcesClicked" ActionId="Settings.PinyinResources" />
            <Label Text="{Binding SettingsUpdatesGroup}" Style="{StaticResource LibrarySection}" />
            <controls:NavigationTile x:Name="UpdateTile" Compact="True" Title="{Binding CheckForUpdates}" Clicked="OnCheckForUpdatesClicked" ActionId="Settings.CheckForUpdates" />
            <Label x:Name="UpdateStatusLabel" IsVisible="False" Style="{StaticResource LibraryMuted}" />
            <Button x:Name="ViewReleaseButton" IsVisible="False" Text="{Binding ViewRelease}" Clicked="OnViewReleaseClicked" Style="{StaticResource LibrarySecondaryButton}" />
            <Label Text="{Binding SettingsDataGroup}" Style="{StaticResource LibrarySection}" />
            <controls:NavigationTile Compact="True" Title="{Binding ExportBackup}" Clicked="OnBackupClicked" ActionId="Settings.Backup" />
            <controls:NavigationTile Compact="True" Title="{Binding PrivacyNotice}" Clicked="OnPrivacyClicked" ActionId="Settings.Privacy" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
