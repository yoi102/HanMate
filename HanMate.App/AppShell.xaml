<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HanMate.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding AppName}">

    <TabBar>
        <ShellContent x:Name="PinyinContent" Title="{Binding NavPinyin}" Route="pinyin" />
        <ShellContent x:Name="LearningContent" Title="{Binding NavLearn}" Route="learn" />
        <ShellContent x:Name="SearchContent" Title="{Binding NavSearch}" Route="search" />
        <ShellContent x:Name="FavoritesContent" Title="{Binding NavFavorites}" Route="favorites" />
        <ShellContent x:Name="SettingsContent" Title="{Binding NavSettings}" Route="settings" />
    </TabBar>

</Shell>
